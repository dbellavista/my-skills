[project]
name = "__NAME__-workspace"
version = "0.1.0"
description = "Python workspace for __NAME__"
requires-python = ">=__PYTHON__"
dependencies = []

[tool.uv]
package = false

[tool.uv.workspace]
members = ["packages/*", "apps/*"]

[tool.uv.sources]
__NAME__-core = { workspace = true }
__NAME__-services = { workspace = true }

[dependency-groups]
dev = ["invoke>=2.2,<3", "ruff>=0.14,<1", "ty>=0.0.49,<1", "pytest>=8,<10", "packaging>=24,<27"]

[tool.ruff]
target-version = "__RUFF_PYTHON__"
line-length = 88

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I", "UP", "B"]

[tool.ruff.lint.isort]
known-first-party = ["__NAMESPACE__", "tasks"]

[tool.ty.src]
include = ["tasks"]
