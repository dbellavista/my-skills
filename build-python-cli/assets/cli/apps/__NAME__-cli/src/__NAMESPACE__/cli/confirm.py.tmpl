"""Explicit confirmation before irreversible changes."""

import sys


def confirm_destructive(description: str, *, yes: bool = False) -> None:
    if yes:
        return
    if not sys.stdin.isatty():
        raise ValueError(
            "Destructive operation requires --yes when stdin is not a terminal"
        )
    if input(f"{description} [y/N] ").strip().lower() not in {"y", "yes"}:
        raise ValueError("Operation cancelled")
