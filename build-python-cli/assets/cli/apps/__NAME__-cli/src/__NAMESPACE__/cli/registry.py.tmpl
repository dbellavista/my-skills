"""Import-free command metadata, search, and documentation."""

from dataclasses import dataclass


@dataclass(frozen=True)
class CommandSpec:
    path: tuple[str, ...]
    target: str
    help: str
    tags: tuple[str, ...] = ()


COMMANDS = (
    CommandSpec(
        ("greet",),
        "__NAMESPACE__.cli.commands.greeting:greet_command",
        "Greet a person.",
        ("greeting", "hello"),
    ),
    CommandSpec(
        ("system", "ping"),
        "__NAMESPACE__.cli.commands.system:ping",
        "Check local command execution.",
        ("health",),
    ),
)


def search(keywords: tuple[str, ...]) -> list[dict[str, str]]:
    matches = []
    for command in COMMANDS:
        text = " ".join((*command.path, command.help, *command.tags)).lower()
        if all(keyword.lower() in text for keyword in keywords):
            matches.append({"command": " ".join(command.path), "help": command.help})
    return matches


def render_catalog() -> str:
    lines = [
        "# __COMMAND__ command catalog",
        "",
        "Generated by `uv run __COMMAND__ catalog --output docs/cli.md`.",
        "",
        "Global options before the command: `--json`, `--log-level`.",
        "",
        "Built-ins: `find <keywords>...`, `catalog [--output PATH]`.",
        "",
        "| Command | Description |",
        "| --- | --- |",
    ]
    lines.extend(
        f"| `__COMMAND__ {' '.join(command.path)}` | {command.help} |"
        for command in COMMANDS
    )
    return "\n".join(lines) + "\n"
